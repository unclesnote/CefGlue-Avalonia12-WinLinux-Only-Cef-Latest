<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xilium.CefGlue.Demo.Avalonia.BrowserView">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                <Button x:Name="mainButton" Content="Main" Click="OnMainButtonClick" />
                <Button x:Name="googleButton" Content="Google" Click="OnGoogleButtonClick" />
                <Button x:Name="amazonButton" Content="Amazon" Click="OnAmazonButtonClick" />
            </StackPanel>
            <TextBox x:Name="addressTextBox" KeyDown="OnAddressTextBoxKeyDown" />
        </DockPanel>
        <Grid x:Name="browserContainer" />
    </DockPanel>
</UserControl>